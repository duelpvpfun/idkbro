# --- Trading mode ---
# PAPER is the only safe mode right now. LIVE is not wired for real orders yet.
TRADING_MODE=PAPER
STARTING_BANKROLL_USD=100

# --- Data feed ---
# Live pump.fun launches + trades come from PumpPortal's free websocket.
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data
# Helius: used for holder checks + on-chain wallet study.
HELIUS_API_KEY=
# Hard daily cap on Helius calls (safety brake vs a runaway loop). Generous early so the
# agent can study lots of wallets and learn fast. Raise/lower to taste.
HELIUS_MAX_CALLS_PER_DAY=800000
WALLET_STUDY_BATCH=20
WALLET_STUDY_INTERVAL_SECONDS=45

# Set true to run fully offline against the built-in market simulator.
USE_SIMULATOR=false
SIM_TOKENS_PER_MINUTE=8

# --- LLM brain (optional; without a key the agent uses its heuristic brains) ---
ANTHROPIC_API_KEY=
ANTHROPIC_FAST_MODEL=claude-haiku-4-5
ANTHROPIC_SMART_MODEL=claude-sonnet-4-5

# --- Observation window ---
OBSERVATION_SECONDS=20

# --- Safety (pump.fun specific) ---
MAX_DEV_HOLDING_PCT=8
MAX_SNIPED_PCT=15

# --- Hard stop-loss (survival floor; take-profit stays the agent's own call) ---
# The agent freely decides when to take profit and can cut early, but it can NEVER hold
# past these floors. This is the catastrophe brake against rugs.
HARD_STOP_ENABLED=true
HARD_STOP_LOSS_PCT=0.40          # force exit if down 40% from entry
HARD_TRAILING_GIVEBACK_PCT=0.55  # force exit if it gives back 55% from peak (once in profit)
HARD_STOP_MIN_PEAK_X=1.5         # trailing floor only arms after reaching 1.5x

# --- Sizing (fractions of equity) ---
SIZE_NORMAL_MIN=0.05
SIZE_NORMAL_MAX=0.10
SIZE_HIGH_MIN=0.11
SIZE_HIGH_MAX=0.18
SIZE_HARD_CAP=0.20
MAX_CONCURRENT_POSITIONS=8

# --- X / Twitter (the agent posts its trading journey) ---
# Master switch. Keep X_DRY_RUN=true first to watch what it WOULD post (spends no credit).
# Flip X_DRY_RUN=false only when you're happy with its voice.
X_ENABLED=false
X_DRY_RUN=true
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_BEARER_TOKEN=
# Credit protection for your $95 budget:
X_MIN_MINUTES_BETWEEN=15
X_MAX_PER_DAY=20
X_POST_BUYS=true
X_POST_CLOSES=true
X_POST_REFLECTIONS=true
# Discovery: reading X is quota-limited on Basic tier, so these are capped hard.
X_READS_PER_DAY=40
X_POSTS_PER_KOL=3
X_FOLLOW_TRUSTED=true

# --- Old-coin revival scanner ---
SCANNER_ENABLED=true
SCANNER_INTERVAL_SECONDS=60

# --- Server ---
HOST=0.0.0.0
PORT=8000
